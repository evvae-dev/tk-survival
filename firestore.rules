rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administrators/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true;
    }
    match /administrators/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /eventCatalog/current {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['revision', 'count', 'updatedAt', 'updatedBy']) &&
        request.resource.data.revision is string && request.resource.data.count is int &&
        request.resource.data.count >= 0 && request.resource.data.count <= 2000 &&
        request.resource.data.updatedBy == request.auth.uid;
    }
    match /eventCatalogRevisions/{revision}/events/{eventId} {
      allow read: if true;
      allow create: if isAdmin();
    }
    match /referenceCatalog/current {
      allow read: if true;
      allow write: if false;
    }
    match /referenceCatalogRevisions/{revision}/{dataset}/{itemId} {
      allow read: if dataset in ['chronology', 'officers'];
      allow write: if false;
    }
  }
}
